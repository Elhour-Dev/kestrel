<?xml version="1.0" encoding="utf-8"?>
<!-- Never back up the encrypted session or other app data to the cloud. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="account.xml" />
    </device-transfer>
</data-extraction-rules>
